{"nodes": [{"id": "web_prisma_readme_ports_adapter_pattern", "label": "Ports & Adapters Architecture Pattern", "file_type": "rationale", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every external dependency (database, email, rate limiter, calendar sync) sits behind an interface in ports.ts, with dev adapters (in-memory/console-logging) swapped for real ones via one line in container.ts, so no use case, Server Action, or component ever imports a concrete adapter directly."}, {"id": "web_prisma_readme_bookingrepository", "label": "BookingRepository interface", "file_type": "concept", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prisma_readme_servicerepository", "label": "ServiceRepository interface", "file_type": "concept", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prisma_readme_solicitorrepository", "label": "SolicitorRepository interface", "file_type": "concept", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prisma_readme_officerepository", "label": "OfficeRepository interface", "file_type": "concept", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prisma_readme_ports_ts", "label": "src/application/booking/ports.ts", "file_type": "code", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prisma_readme_container_ts", "label": "src/infrastructure/container.ts", "file_type": "code", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prisma_readme_schema_prisma", "label": "prisma/schema.prisma", "file_type": "code", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prisma_readme_data_ts_files", "label": "src/data/*.ts seed files", "file_type": "code", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prisma_readme_prismabookingrepository", "label": "PrismaBookingRepository", "file_type": "code", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prisma_readme_createifslotfree", "label": "createIfSlotFree method", "file_type": "rationale", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The in-memory adapter checks-then-inserts synchronously, safe only because JS is single-threaded per request. Postgres needs either a SERIALIZABLE transaction wrapping the overlap check + insert, or (recommended) a DB-level EXCLUDE constraint using btree_gist, so double-booking is impossible even under concurrent requests \u2014 something an application-level check alone can't guarantee."}, {"id": "web_prisma_readme_rescheduleifslotfree", "label": "rescheduleIfSlotFree method", "file_type": "rationale", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same EXCLUDE constraint covers rescheduling: attempt the UPDATE, catch the constraint-violation error, return false."}, {"id": "web_prisma_readme_exclude_constraint", "label": "btree_gist EXCLUDE constraint", "file_type": "rationale", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A DB-level guarantee over (solicitor_slug, tstzrange(slot_start_utc, slot_end_utc)) added as a raw-SQL migration alongside the Prisma schema, making double-booking impossible even under concurrent requests."}, {"id": "web_prisma_readme_serializable_transaction", "label": "SERIALIZABLE transaction (alternative)", "file_type": "rationale", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An alternative to the EXCLUDE constraint: wrap the overlap check + insert in a SERIALIZABLE transaction."}, {"id": "web_prisma_readme_inmemorybookingrepository", "label": "InMemoryBookingRepository", "file_type": "code", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prisma_readme_staticservicerepository", "label": "StaticServiceRepository", "file_type": "code", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prisma_readme_staticsolicitorrepository", "label": "StaticSolicitorRepository", "file_type": "code", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prisma_readme_staticofficerepository", "label": "StaticOfficeRepository", "file_type": "code", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "web_prisma_readme_service", "label": "Service (domain entity)", "file_type": "concept", "source_file": "web/prisma/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor