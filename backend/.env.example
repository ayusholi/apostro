# Copy to .env for local development. Every variable here is validated at
# boot by src/config — an unset or malformed required value crashes the
# process immediately rather than starting degraded (ARCHITECTURE.md §14).

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Database (Prisma) ──────────────────────────────────────────────────────
# Local dev default: `docker compose up postgres redis` for infra, app on
# the host. See DATABASE-DESIGN.md for the eventual full schema.
DATABASE_URL=postgresql://alls:alls@localhost:5432/alls?schema=public

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Security ─────────────────────────────────────────────────────────────
# Comma-separated exact-origin allowlist (ARCHITECTURE.md §13) — no wildcards.
CORS_ORIGINS=http://localhost:3000
# Number of hops behind a reverse proxy/load balancer (e.g. "1"), or "false"
# for local dev with no proxy in front. Wrong value here silently breaks
# per-IP rate limiting later (ARCHITECTURE.md §13).
TRUST_PROXY=false

# ── Auth (JWT, AUTH-DESIGN.md §2.1) ─────────────────────────────────────────
# RS256 keypair. Required — there is deliberately no default here, since a
# shared example key baked into a template is exactly how "the tutorial's
# JWT secret" ends up live in production. Generate your own for local dev:
#
#   openssl genrsa -out /tmp/jwt-private.pem 2048
#   openssl rsa -in /tmp/jwt-private.pem -pubout -out /tmp/jwt-public.pem
#
# Then paste each PEM in with literal "\n" in place of real newlines (a
# single env-var line can't hold a raw multi-line value) — src/config
# unescapes them at boot:
#
#   awk '{printf "%s\\n", $0}' /tmp/jwt-private.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# ── Not yet configured ─────────────────────────────────────────────────────
# Mail provider credentials, object storage, and Sentry are introduced with
# their respective modules — see INFRASTRUCTURE-DESIGN.md. Nothing in this
# codebase reads them yet.
